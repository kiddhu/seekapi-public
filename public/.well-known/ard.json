              },
              {
                "action": "prepare_runtime",
                "method": "POST",
                "instructions": "Submit RFQ_AGENT_INTENT_V2 draft. Review normalized requirement, digest and missing facts; preparation has zero paid effects."
              },
              {
                "action": "session",
                "method": "POST",
                "instructions": "Start a private buyer session and retain its cookie. Do not publish cookie or credentials."
              },
              {
                "action": "confirm",
                "method": "POST",
                "instructions": "Using the same session, send draft as the exact returned prepared object without receipt, receipt separately, requirement_digest and acknowledgement CONFIRM_RFQ_REQUIREMENT. Never reconstruct or edit signed prepared content; prepare again after edits or expiry."
              },
              {
                "action": "checkout",
                "method": "POST",
                "instructions": "Using the same session and returned private access, request one Stripe Hosted Checkout for the confirmed requirement. The buyer approves payment; no goods payment is authorized."
              },
              {
                "action": "result",
                "method": "POST",
                "instructions": "Read status and result with private access and the same session. Existing authenticated reads are free; do not pay again."
              },
              {
                "action": "checkout_return",
                "method": "POST",
                "instructions": "Use the original private return reference in the same session to reconcile the existing Checkout. A browser return is not proof of payment."
              },
              {
                "action": "renew",
                "method": "POST",
                "instructions": "Use private renewal capability and stable request_id to recover existing access. Keep credentials private; never use this to create another order."
